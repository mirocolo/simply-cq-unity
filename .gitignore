# ---- 本地开发工具（.NET SDK 约 200MB，不进版本库）----
LocalTools/

# ---- 自检工程的构建产物 ----
Tools/**/bin/
Tools/**/obj/

# ---- 生成器脚本互相 import 时留下的字节码缓存 ----
Tools/**/__pycache__/

# Unity 模板的 *.csproj 规则会误伤自检工程，这两个必须提交
!Tools/**/*.csproj
