<Project Sdk="Microsoft.NET.Sdk">

  <!-- 无头编译检查：把 Domain + Data + Unity + Editor 四层一起编译。
       依赖 Stubs/ 里的最小 UnityEngine/UnityEditor 桩，因此不需要安装 Unity。 -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>UnityCompileCheck</AssemblyName>
    <DefineConstants>ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <NoWarn>CS0649;CS0169;CS0414;CS0067;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/**/*.cs" />
    <Compile Include="Stubs/**/*.cs" />
  </ItemGroup>

</Project>
